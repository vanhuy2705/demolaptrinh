<Project>

  <!--
    Thuộc tính dùng chung cho toàn bộ solution.
    ============================================================
    ĐỔI PHIÊN BẢN .NET TẠI ĐÂY (1 dòng) nếu Visual Studio của bạn cũ:
        Visual Studio 2026  ->  <PhienBanNet>10.0</PhienBanNet>   (mặc định)
        Visual Studio 2022  ->  <PhienBanNet>8.0</PhienBanNet>
        Visual Studio 2019  ->  <PhienBanNet>6.0</PhienBanNet>
    Sau khi đổi: Build > Clean Solution rồi Build lại.
    ============================================================
  -->
  <PropertyGroup>
    <PhienBanNet>10.0</PhienBanNet>
    <NetLib>net$(PhienBanNet)</NetLib>
    <NetWinForms>net$(PhienBanNet)-windows</NetWinForms>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>vi</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <!-- Cho phép build project Windows (WinForms) trên mọi nền tảng -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

</Project>
